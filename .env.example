# ==============================================================================
# STORE DETAILING - MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG
# ==============================================================================
# Hướng dẫn:
# 1. Tạo file .env.local ở thư mục gốc (ngang hàng package.json).
# 2. Dán link Google Apps Script Web App URL vào dòng dưới đây.
# 3. File .env.local đã nằm trong .gitignore nên KHÔNG BAO GIỜ bị đẩy lên Git/GitHub!

# Google Apps Script Web App URL (Đóng vai trò Backend bảo mật)
# Tự động lưu Google Sheet và bắn thông báo Telegram Bot
VITE_GOOGLE_SCRIPT_URL=
